# Copy to .env (repo root) and adjust. Never commit .env.
# ---- Django API ----
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Obscure admin path; set something non-default in any shared environment.
DJANGO_ADMIN_URL=admin/
DATABASE_URL=postgres://tommysbus:tommysbus_dev_only@127.0.0.1:5442/tommysbus
# Number of trusted reverse proxies in front of Django (Next.js rewrite = 1).
# Used for per-client rate limiting. Set 0 if Django is exposed directly.
DJANGO_NUM_PROXIES=1
BOOKING_HOLD_MINUTES=60

# ---- Postgres container (infra/compose.yaml) ----
POSTGRES_DB=tommysbus
POSTGRES_USER=tommysbus
POSTGRES_PASSWORD=tommysbus_dev_only
POSTGRES_PORT=5442

# ---- Next.js web (apps/web reads these from its own environment) ----
# Server-side base URL of the Django API (SSR fetches + /api rewrite target).
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
